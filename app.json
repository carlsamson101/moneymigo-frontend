{
  "expo": {
    "name": "MoneyMigo",
    "slug": "moneymate-frontend",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/moneymigo-icon.png",
    "splash": {
      "image": "./assets/images/moneymigo-logo-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d27d8f24-2514-48f7-b171-d0835f9a4976"
    },
    "scheme": "moneymigo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneymigo.app",
      "buildNumber": "1.1.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "MoneyMigo needs camera access to scan receipts and take photos.",
        "NSPhotoLibraryUsageDescription": "MoneyMigo needs access to your Photos and Videos to upload receipts or media.",
        "NSMicrophoneUsageDescription": "MoneyMigo needs microphone access for voice command and audio features.",
        "NSSpeechRecognitionUsageDescription": "MoneyMigo needs speech recognition to add expenses by voice."
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/moneymigo-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.moneymigo.app"
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/moneymigo-icon.png",
      "themeColor": "#1f4b81",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "meta": {
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "default"
      }
    },

    "plugins": [
  "expo-router",
  "expo-secure-store",
  "expo-web-browser",
  [
    "expo-image-picker",
    {
      "photosPermission": "MoneyMigo needs access to your Photos and Videos to upload receipts or media.",
      "cameraPermission": "MoneyMigo needs camera access to scan receipts and take photos."
    }
  ]
],

    "extra": {
      "router": {},
      "eas": {
        "projectId": "d27d8f24-2514-48f7-b171-d0835f9a4976"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}